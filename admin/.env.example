# Copy to .env and replace every placeholder locally. Never commit real values.
# Invalid or missing values make every request a plain 503 (fail closed).

# First URL path segment; >= 32 chars of [A-Za-z0-9_-] only.
ADMIN_PATH_SECRET=<replace-with-32+-random-chars-from-A-Za-z0-9_-dash>

# Basic-auth user (any non-empty string).
ADMIN_USER=<replace-with-user>

# Basic-auth password hash: argon2id PHC ($argon2id$...) from
# `npm run hash-password`, or a bcrypt $2b$ hash.
ADMIN_PASSWORD_HASH=<replace-with-argon2id-or-bcrypt-hash>

# Postgres connection; the URL user must be exactly meshgrounds_admin, or
# meshgrounds_admin.<project-ref> for the Supabase pooler.
ADMIN_DATABASE_URL=postgres://meshgrounds_admin@<host>:<port>/<database>

# Exact https origin of the admin deployment (no path, no trailing slash,
# never meshground.app or a subdomain of it). Checked on every POST.
ADMIN_ORIGIN=https://<your-admin-deployment>.vercel.app

# Auth user id of the one admin account. A UUID. Case is ignored.
ADMIN_USER_ID=00000000-0000-4000-8000-000000000000

# https URL of the Supabase project. http is rejected, including local Auth.
ADMIN_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key for that project. Non-empty, no spaces or newlines.
# This app does not take a secret key.
ADMIN_SUPABASE_ANON_KEY=<replace-with-anon-key>
