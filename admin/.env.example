# Copy to .env and replace every placeholder locally. Never commit real values.
# Invalid or missing values make every request a plain 503 (fail closed).

# First URL path segment; >= 32 chars of [A-Za-z0-9_-] only.
ADMIN_PATH_SECRET=<replace-with-32+-random-chars-from-A-Za-z0-9_-dash>

# Basic-auth user (any non-empty string).
ADMIN_USER=<replace-with-user>

# Basic-auth password hash: argon2id PHC ($argon2id$...) from
# `npm run hash-password`, or a bcrypt $2b$ hash.
ADMIN_PASSWORD_HASH=<replace-with-argon2id-or-bcrypt-hash>

# Postgres connection; the URL user must be exactly meshgrounds_admin.
ADMIN_DATABASE_URL=postgres://meshgrounds_admin@<host>:<port>/<database>

# Exact origin of the admin deployment; required for POSTs (CSRF check).
ADMIN_ORIGIN=http://localhost:56905
