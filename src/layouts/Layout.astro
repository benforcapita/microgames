---
import '../styles/global.css';
import { ADSENSE_CLIENT } from '../lib/server/config';
import InstallPrompt from '../components/InstallPrompt.astro';

interface Props {
  title?: string;
  description?: string;
  ads?: boolean;
  /** PV-1: keep the page out of search engines (non-live games, owner-only pages). */
  noindex?: boolean;
}
const {
  title,
  description = 'Meshground — the open ground for instant 3D web games. Play free browser games, and upload your own single-file Three.js game.',
  ads = false,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Meshground` : 'Meshground — The Open Ground for Instant 3D Web Games';
const path = Astro.url.pathname;
const { profile } = Astro.locals;
// Send people back where they were after auth, but never bounce them back onto an auth page.
const authNext = ['/login', '/signup', '/onboarding'].includes(path) ? (Astro.url.searchParams.get('next') ?? '/') : path;
const nav = [
  { href: '/games', label: 'Play' },
  { href: '/proving', label: 'Proving Grounds' },
  { href: '/creators', label: 'Creators' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#090a0f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Meshground" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script is:inline>
      addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); window.__mgInstallEvent = e; }, { once: true });
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {
      ads && ADSENSE_CLIENT && (
        <>
          <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" data-ad-frequency-hint="30s" />
          <script is:inline>
            window.adsbygoogle = window.adsbygoogle || [];
            window.adBreak = window.adConfig = function (o) { window.adsbygoogle.push(o); };
            window.adConfig({ preloadAdBreaks: 'on', sound: 'on' });
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap spread">
        <a href="/" class="logo" aria-label="Meshground home">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>mesh<b>ground</b></span>
        </a>
        <nav class="row">
          {nav.map((n) => <a class="navlink" href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          {
            profile ? (
              <>
                {profile.role === 'admin' && <a href="/admin" class="navlink admin" aria-current={path.startsWith('/admin') ? 'page' : undefined}>Admin</a>}
                <a href="/me" class="me" aria-current={path === '/me' ? 'page' : undefined}>@{profile.handle}</a>
              </>
            ) : (
              <>
                <a href={`/login?next=${encodeURIComponent(authNext)}`} aria-current={path === '/login' ? 'page' : undefined}>Log in</a>
                <a class="btn ghost sm signup" href={`/signup?next=${encodeURIComponent(authNext)}`} aria-current={path === '/signup' ? 'page' : undefined}>Sign up</a>
              </>
            )
          }
          <a class="btn sm upload" href={profile ? '/me#upload' : '/upload'}><span>Upload<span class="xs-hide"> a game</span></span></a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap spread">
        <span class="muted">© {new Date().getFullYear()} Meshground · The open ground for instant 3D web games.</span>
        <span class="row">
          <a href="/creators#rules" class="muted">Content rules</a>
          <a href="/EXCHANGE_SDK.md" class="muted">EXCHANGE_SDK.md</a>
        </span>
      </div>
    </footer>
    <InstallPrompt />
    <script>
      import { installPortalErrors } from '../client/site-events';
      installPortalErrors();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: #090a0fcc;
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap { height: 62px; flex-wrap: nowrap; }
  .logo { flex-shrink: 0; display: flex; align-items: center; gap: 0.55rem; text-decoration: none; font: 500 1.15rem var(--mono); letter-spacing: -0.02em; }
  .logo b { color: var(--accent); }
  nav { gap: 1.25rem; flex-wrap: nowrap; min-width: 0; }
  nav a { white-space: nowrap; }
  nav a:not(.btn) { text-decoration: none; color: var(--muted); font-weight: 600; font-size: 0.92rem; }
  nav a:not(.btn):hover, nav a[aria-current='page'] { color: var(--text); }
  nav a.me { font-family: var(--mono); color: var(--accent); }
  nav a.admin { color: var(--warn); }
  .site-footer { border-top: 1px solid var(--line); padding: 1.5rem 0; margin-top: 3rem; font-size: 0.85rem; }
  .site-footer a { text-decoration: none; }
  /* Section links hide until Log in, Sign up, and Upload fit on one line (741px). */
  @media (max-width: 740px) {
    nav a.navlink { display: none; }
    nav { gap: 0.6rem; }
    nav a.me { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  }
  /* With the 1rem inset, logo + Log in + Sign up + Upload is 384px. Hide Upload until it fits. */
  @media (max-width: 384px) {
    .site-header .wrap:has(a[href^='/login']) a.upload { display: none; }
  }
  @media (max-width: 419px) {
    .xs-hide { display: none; }
    .site-header .wrap:has(a[href^='/login']) nav { gap: 0.35rem; }
    .site-header .wrap:has(a[href^='/login']) .btn.sm { padding-inline: 0.45rem; }
  }
</style>
