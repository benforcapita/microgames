---
import '../styles/global.css';
import { ADSENSE_CLIENT } from '../lib/server/config';

interface Props {
  title?: string;
  description?: string;
  ads?: boolean;
}
const {
  title,
  description = 'Meshgrounds — the open ground for instant 3D web games. Play free browser games, upload your own single-file Three.js game, and earn ad revenue.',
  ads = false,
} = Astro.props;
const fullTitle = title ? `${title} · Meshgrounds` : 'Meshgrounds — The Open Ground for Instant 3D Web Games';
const path = Astro.url.pathname;
const { profile } = Astro.locals;
// Send people back where they were after auth, but never bounce them back onto an auth page.
const authNext = ['/login', '/signup', '/onboarding'].includes(path) ? (Astro.url.searchParams.get('next') ?? '/') : path;
const nav = [
  { href: '/games', label: 'Play' },
  { href: '/proving', label: 'Proving Grounds' },
  { href: '/creators', label: 'Creators' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {
      ads && ADSENSE_CLIENT && (
        <>
          <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" data-ad-frequency-hint="30s" />
          <script is:inline>
            window.adsbygoogle = window.adsbygoogle || [];
            window.adBreak = window.adConfig = function (o) { window.adsbygoogle.push(o); };
            window.adConfig({ preloadAdBreaks: 'on', sound: 'on' });
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap spread">
        <a href="/" class="logo" aria-label="Meshgrounds home">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>mesh<b>grounds</b></span>
        </a>
        <nav class="row">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          {
            profile ? (
              <a href="/me" class="me" aria-current={path === '/me' ? 'page' : undefined}>@{profile.handle}</a>
            ) : (
              <>
                <a href={`/login?next=${encodeURIComponent(authNext)}`} aria-current={path === '/login' ? 'page' : undefined}>Log in</a>
                <a class="btn ghost sm signup" href={`/signup?next=${encodeURIComponent(authNext)}`} aria-current={path === '/signup' ? 'page' : undefined}>Sign up</a>
              </>
            )
          }
          <a class="btn sm" href="/upload">Upload a game</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap spread">
        <span class="muted">© {new Date().getFullYear()} Meshgrounds · The open ground for instant 3D web games.</span>
        <span class="row">
          <a href="/creators#rules" class="muted">Content rules</a>
          <a href="/EXCHANGE_SDK.md" class="muted">EXCHANGE_SDK.md</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: #090a0fcc;
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap { height: 62px; }
  .logo { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; font: 500 1.15rem var(--mono); letter-spacing: -0.02em; }
  .logo b { color: var(--accent); }
  nav { gap: 1.25rem; }
  nav a:not(.btn) { text-decoration: none; color: var(--muted); font-weight: 600; font-size: 0.92rem; }
  nav a:not(.btn):hover, nav a[aria-current='page'] { color: var(--text); }
  nav a.me { font-family: var(--mono); color: var(--accent); }
  .site-footer { border-top: 1px solid var(--line); padding: 1.5rem 0; margin-top: 3rem; font-size: 0.85rem; }
  .site-footer a { text-decoration: none; }
  @media (max-width: 640px) {
    nav a:not(.btn):not(.me) { display: none; }
  }
</style>
