---
import Layout from '../../layouts/Layout.astro';
import AssetWarnings from '../../components/AssetWarnings.astro';
import { summarizeAssets, type AssetInputItem } from '../../lib/asset-limits';
import { isAdmin } from '../../lib/server/profiles';
import { loadAssetSummaryInput, sqlSubmissionStore } from '../../lib/server/submissions-db';
import { getGameOwnerId, listActivePreviewLinks } from '../../lib/server/preview-links';
import {
  isSubmissionPreview,
  previewSubmissionView,
  readSubmission,
  submissionStageLabel,
  type SubmissionView,
} from '../../lib/server/submissions';

const id = Astro.params.id ?? '';
const preview = isSubmissionPreview(id);
if (!preview && !Astro.locals.user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const result = preview
  ? { status: 200 as const, view: previewSubmissionView() }
  : await readSubmission({ userId: Astro.locals.user!.id, gameId: id, store: sqlSubmissionStore, reviewer: isAdmin(Astro.locals.profile) });

if (result.status === 401) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
if (result.status !== 200) return Astro.rewrite('/404');

const PREVIEW_ASSETS: AssetInputItem[] = [
  { path: 'sprites/hero.png', status: 'uploaded', sizeBytes: 180 * 1024 },
  { path: 'audio/jump.mp3', status: 'missing', sizeBytes: null },
];

const assetSummaryInput = preview
  ? { codeBytes: 48 * 1024, assets: PREVIEW_ASSETS }
  : await loadAssetSummaryInput(id);
const assetSummary = summarizeAssets(assetSummaryInput);

const view: SubmissionView = result.view;
const staticChecks = view.validation?.checks.filter((c) => c.source === 'static') ?? [];
const runChecks = view.validation?.checks.filter((c) => c.source === 'run') ?? [];
const stageLabel = submissionStageLabel(view.game.stage, view.validation?.status ?? null);
const awaitingReview = view.game.stage === 'pending' && view.validation?.status === 'passed';
const ownerId = preview ? null : await getGameOwnerId(id);
const isOwner = !preview && Boolean(Astro.locals.user && ownerId && ownerId === Astro.locals.user.id);
const activeLinks = isOwner
  ? await listActivePreviewLinks({ supabase: Astro.locals.supabase, gameId: id })
  : [];
---

<Layout title={`${view.game.title} · Submission`} description={`Validation status for ${view.game.title}.`}>
  <section
    class="section wrap report"
    id="submission"
    data-id={view.game.id}
    data-stamp={view.stamp}
    data-terminal={view.terminal ? '1' : '0'}
    data-preview={preview ? '1' : '0'}
  >
    <span class="eyebrow">Submission</span>
    <div class="spread head">
      <h1>{view.game.title}</h1>
      <span class="row">
        <span class:list={['badge', view.game.stage]}>{stageLabel}</span>
        {
          view.headline !== stageLabel && (
            <span class:list={['badge', 'phase', view.phase]} aria-live="polite">{view.headline}</span>
          )
        }
      </span>
    </div>
    <p class="muted lead">{view.detail}</p>
    {
      !view.published && (
        <p class="panel visibility" id="visibility">
          <b>{view.game.stage === 'rejected' ? 'Not public.' : 'Not public yet.'}</b>{' '}
          {view.game.stage === 'rejected'
            ? "Players can't find or play this game. Only you can see this page."
            : "Players can't find or play this game until a reviewer publishes it. Only you can see this page."}
        </p>
      )
    }

    <AssetWarnings summary={assetSummary} />

    {view.published && (
      <p class="row">
        <a class="btn" href={`/play/${view.game.slug}`}>Open in the Proving Grounds</a>
      </p>
    )}
    {awaitingReview && (
      <p class="row">
        <a class="btn" href={`/play/${view.game.slug}`}>Preview your game</a>
      </p>
    )}
    {view.game.stage === 'rejected' && view.game.reviewNote && (
      <p class="panel notice" id="review-note">{view.game.reviewNote}</p>
    )}
    {view.phase === 'failed' && (
      <p class="row">
        <a class="btn" href="/me#upload">Upload a fixed version</a>
      </p>
    )}

    {isOwner && (
      <section class="panel share-links" id="share-links">
        <div class="spread head">
          <h2>Share preview</h2>
          <button type="button" class="btn" id="share-preview-btn">Share preview</button>
        </div>
        <div id="new-link-panel" class="panel new-link" hidden>
          <div class="row">
            <input type="text" id="created-link-url" readonly />
            <button type="button" class="btn sm" id="copy-preview-link">Copy</button>
          </div>
          <p class="muted once-note">This link is shown only once. Copy it now.</p>
        </div>
        <p id="share-error" class="muted error" hidden></p>
        <ul id="active-links-list" class="active-links" aria-label="Active preview links">
          {activeLinks.map((link) => (
            <li class="spread link-row" data-link-id={link.id}>
              <span>Expires {new Date(link.expiresAt).toLocaleDateString()} · {link.viewCount} {link.viewCount === 1 ? 'view' : 'views'}</span>
              <button type="button" class="btn sm ghost revoke-btn" data-link-id={link.id}>Revoke</button>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="panel">
      <h2>Static checks</h2>
      {staticChecks.length ? (
        <ul class="checks">
          {staticChecks.map((c) => (
            <li>
              <span class:list={['mark', c.level]}>{c.level}</span>
              <div>
                <strong>{c.name}</strong>
                <p>{c.message}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">No static checks recorded yet.</p>
      )}
    </section>
    <section class="panel">
      <h2>Headless run</h2>
      {runChecks.length ? (
        <ul class="checks">
          {runChecks.map((c) => (
            <li>
              <span class:list={['mark', c.level]}>{c.level}</span>
              <div>
                <strong>{c.name}</strong>
                <p>{c.message}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">{view.phase === 'waiting' || view.phase === 'queued' ? 'The headless run has not started.' : 'No headless checks recorded yet.'}</p>
      )}
    </section>

    {view.validation?.console.length ? (
      <section class="panel">
        <h2>Console</h2>
        <ul class="log">
          {view.validation.console.map((line) => <li>{line}</li>)}
        </ul>
      </section>
    ) : null}

    {view.validation?.blockedRequests.length ? (
      <section class="panel">
        <h2>Blocked requests</h2>
        <ul class="log">
          {view.validation.blockedRequests.map((line) => <li>{line}</li>)}
        </ul>
      </section>
    ) : null}

    {view.validation?.timings ? (
      <section class="panel">
        <h2>Timings</h2>
        <ul class="log">
          {Object.entries(view.validation.timings).map(([key, value]) => <li>{key}: {value}</li>)}
        </ul>
      </section>
    ) : null}

    {!view.terminal && (
      <p id="poll-note" class="muted poll">
        {awaitingReview
          ? 'This page updates when a reviewer publishes the game.'
          : 'This page checks again every few seconds until validation finishes.'}
      </p>
    )}
  </section>
</Layout>

<script>
  const root = document.getElementById('submission');
  const note = document.getElementById('poll-note');
  if (root && note && root.dataset.terminal !== '1' && root.dataset.preview !== '1') {
    const stamp = root.dataset.stamp;
    const id = root.dataset.id ?? '';
    const started = Date.now();
    const tick = async () => {
      if (Date.now() - started > 10 * 60 * 1000) {
        note.textContent = 'This is taking longer than usual. Refresh to check again.';
        return;
      }
      try {
        const res = await fetch(`/api/submissions/${encodeURIComponent(id)}`, { headers: { accept: 'application/json' } });
        if (res.status === 401) {
          location.assign(`/login?next=${encodeURIComponent(location.pathname)}`);
          return;
        }
        if (!res.ok) {
          setTimeout(tick, 4000);
          return;
        }
        const data = (await res.json()) as { stamp?: string };
        if (data.stamp && data.stamp !== stamp) location.reload();
        else setTimeout(tick, 2000);
      } catch {
        setTimeout(tick, 4000);
      }
    };
    setTimeout(tick, 2000);
  }

  const shareSection = document.getElementById('share-links');
  if (shareSection) {
    const root = document.getElementById('submission');
    const gameId = root?.dataset.id ?? '';
    const shareBtn = document.getElementById('share-preview-btn');
    const newLinkPanel = document.getElementById('new-link-panel');
    const createdLinkUrl = document.getElementById('created-link-url');
    const copyBtn = document.getElementById('copy-preview-link');
    const shareError = document.getElementById('share-error');
    const activeLinksList = document.getElementById('active-links-list');

    const showError = (msg: string) => {
      if (!shareError) return;
      shareError.textContent = msg;
      shareError.hidden = false;
    };

    const clearError = () => {
      if (!shareError) return;
      shareError.textContent = '';
      shareError.hidden = true;
    };

    const attachRevoke = (btn: Element) => {
      btn.addEventListener('click', async () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const linkId = btn.dataset.linkId;
        if (!linkId) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/submissions/${encodeURIComponent(gameId)}/preview-links/${encodeURIComponent(linkId)}/revoke`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          if (!res.ok) {
            btn.disabled = false;
            showError('Could not revoke preview link');
            return;
          }
          btn.closest('li')?.remove();
        } catch {
          btn.disabled = false;
          showError('Could not revoke preview link');
        }
      });
    };

    shareSection.querySelectorAll('.revoke-btn').forEach(attachRevoke);

    if (copyBtn && createdLinkUrl instanceof HTMLInputElement) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = createdLinkUrl.value;
        if (!textToCopy) return;
        try {
          await navigator.clipboard.writeText(textToCopy);
        } catch {
          createdLinkUrl.select();
        }
      });
    }

    if (shareBtn instanceof HTMLButtonElement) {
      shareBtn.addEventListener('click', async () => {
        clearError();
        shareBtn.disabled = true;
        try {
          const res = await fetch(`/api/submissions/${encodeURIComponent(gameId)}/preview-links`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          const raw = await res.json().catch(() => null);
          const isObj = typeof raw === 'object' && raw !== null;
          const errorMsg = isObj && 'error' in raw && typeof raw.error === 'string' ? raw.error : null;
          const url = isObj && 'url' in raw && typeof raw.url === 'string' ? raw.url : '';
          const id = isObj && 'id' in raw && typeof raw.id === 'string' ? raw.id : '';
          const expiresAt = isObj && 'expiresAt' in raw && typeof raw.expiresAt === 'string' ? raw.expiresAt : '';
          const viewCount = isObj && 'viewCount' in raw && typeof raw.viewCount === 'number' ? raw.viewCount : 0;

          if (!res.ok) {
            showError(errorMsg || 'Could not create preview link. Please try again.');
            return;
          }

          if (createdLinkUrl instanceof HTMLInputElement && newLinkPanel) {
            createdLinkUrl.value = url;
            newLinkPanel.hidden = false;
          }

          if (activeLinksList && id) {
            const li = document.createElement('li');
            li.className = 'spread link-row';
            li.dataset.linkId = id;

            const infoSpan = document.createElement('span');
            const expStr = expiresAt ? new Date(expiresAt).toLocaleDateString() : '';
            infoSpan.textContent = `Expires ${expStr} · ${viewCount} ${viewCount === 1 ? 'view' : 'views'}`;

            const revokeBtn = document.createElement('button');
            revokeBtn.type = 'button';
            revokeBtn.className = 'btn sm ghost revoke-btn';
            revokeBtn.dataset.linkId = id;
            revokeBtn.textContent = 'Revoke';
            attachRevoke(revokeBtn);

            li.appendChild(infoSpan);
            li.appendChild(revokeBtn);
            activeLinksList.prepend(li);
          }
        } catch {
          showError('Could not create preview link. Please try again.');
        } finally {
          shareBtn.disabled = false;
        }
      });
    }
  }
</script>

<style>
  .report { max-width: 820px; display: grid; gap: 1rem; }
  .head { align-items: flex-end; }
  .head h1 { margin: 0; }
  .lead { margin: 0; max-width: 62ch; }
  .visibility { margin: 0; padding: 0.75rem 1rem; font-size: 0.9rem; border-color: #ffb02e55; }
  .visibility b { color: var(--warn); }
  .phase.running, .phase.queued, .phase.waiting { color: var(--warn); border-color: #ffb34055; }
  .phase.passed { color: var(--accent); border-color: #c4ff3d55; }
  .phase.failed, .phase.error { color: var(--bad); border-color: #ff5d5d55; }
  .checks { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.75rem; }
  .checks li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; }
  .checks p { margin: 0.15rem 0 0; color: var(--muted); }
  .mark {
    font: 700 0.68rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .mark.pass { color: var(--accent); border-color: #c4ff3d55; }
  .mark.warn { color: var(--warn); border-color: #ffb34055; }
  .mark.fail { color: var(--bad); border-color: #ff5d5d55; }
  .log { list-style: none; padding: 0; margin: 0.5rem 0 0; font: 0.85rem/1.45 var(--mono); color: var(--muted); }
  .poll { margin: 0; }
  h2 { font-size: 1rem; margin: 0; }
  .share-links { display: grid; gap: 0.75rem; }
  .share-links [hidden] { display: none; }
  .new-link { display: grid; gap: 0.5rem; background: var(--bg-alt, rgba(255,255,255,0.03)); padding: 0.75rem; }
  .new-link input { flex: 1; min-width: 0; font-family: var(--mono); font-size: 0.85rem; padding: 0.4rem 0.6rem; }
  .once-note { margin: 0; font-size: 0.85rem; }
  .error { color: var(--bad); margin: 0; }
  .active-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .link-row { align-items: center; padding: 0.5rem 0; border-top: 1px solid var(--line); font-size: 0.9rem; }
</style>
