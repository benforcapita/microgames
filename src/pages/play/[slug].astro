---
import Layout from '../../layouts/Layout.astro';
import Rate from '../../components/Rate.astro';
import GameCard from '../../components/GameCard.astro';
import GameThumb from '../../components/GameThumb.astro';
import ReviewActions from '../../components/ReviewActions.astro';
import { ratingLabel } from '../../lib/rating';
import { getGame, getHealth, getUserRating, listGames, ownerReviewMarks } from '../../lib/server/games';
import { CDN_ORIGIN, GRADUATION } from '../../lib/server/config';
import { isListable } from '../../lib/server/game-rules';
import { ownerPreviewToken, reviewerPreviewToken } from '../../lib/server/owner-preview';
import { isAdmin } from '../../lib/server/profiles';
import { ago, compact, count, formatCheck, kb } from '../../lib/format';
import { desktopOnlyNotice, forkParentLinked, playSurface } from '../../lib/server/device';

const { user, profile } = Astro.locals;
const device = Astro.locals.device;
const admin = isAdmin(profile);

// Owners can open their own pending/rejected game, admins any game (to review it); everyone else gets a 404 (canViewGame).
const game = await getGame(Astro.params.slug ?? '', { viewerId: Astro.locals.user?.id, includeUnpublished: admin });
if (!game) return Astro.rewrite('/404');
if (Astro.params.slug !== game.slug) return Astro.redirect(`/play/${game.slug}`, 301);

// PV-1: related lists (forks, more from this creator) only ever contain listable games; the "forked from" link is
// hidden when the parent is unlisted, unless the viewer owns it.
const [{ checks }, mine, parentGame, forks, byCreator] = await Promise.all([
  getHealth(game.id),
  getUserRating(game.id, user?.id),
  game.forkedFrom ? getGame(game.forkedFrom) : null,
  listGames({ forkedFrom: game.id, limit: 50, device }),
  listGames({ creator: game.creator, limit: 5, device }),
]);
const more = byCreator.filter((g) => g.id !== game.id).slice(0, 4);
const parent = parentGame && (isListable(parentGame) || (!!user && parentGame.ownerId === user.id)) ? parentGame : null;
const desktopOnly = playSurface(device, game.inputSupport) === 'desktop-only';
const notice = desktopOnlyNotice(game.title);
const isOwner = !!user && user.id === game.ownerId;
const ownerMark = isOwner ? (await ownerReviewMarks([game.id])).get(game.id) : undefined;
const awaitingReview = isOwner && game.stage === 'pending' && ownerMark?.latestStatus === 'passed';
// SP-6: the CDN serves pending/rejected bundles only with a short-lived token, minted only for the owner here.
const previewToken = ownerPreviewToken(game, user?.id) ?? reviewerPreviewToken(game, admin);
const ptQuery = previewToken ? `&pt=${encodeURIComponent(previewToken)}` : '';
const remixable = game.license !== 'All rights reserved';
const live = game.stage === 'live';
// PV-1: non-live games stay reachable by direct link (200) but are kept out of search indexes (header + meta).
if (!live) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const passed = checks.filter((c) => c.pass).length;
const uploaded = Astro.url.searchParams.has('uploaded');
---

<Layout title={game.title} description={game.tagline || `Play ${game.title} instantly in your browser.`} ads={live && !desktopOnly} noindex={!live}>
  <section class="wrap play">
    {
      uploaded && (
        <div class="notice panel">
          <b>You're live in the Proving Grounds.</b> Share the link: real plays and ratings decide when the game is eligible for the main arcade.
        </div>
      )
    }
    {
      awaitingReview && (
        <div class="notice panel" id="awaiting-review">
          <b>Awaiting review.</b> Anyone with a share link can play this until it is published.
        </div>
      )
    }
    {
      isOwner && game.stage === 'rejected' && game.reviewNote && (
        <div class="notice panel" id="review-note">{game.reviewNote}</div>
      )
    }
    {
      admin && !isOwner && (
        <div class="notice panel reviewer spread" id="reviewer">
          <span>
            <b>Reviewing as admin.</b> Stage: <span class:list={['badge', game.stage]}>{game.stage}</span>
            {game.reviewNote && <span class="muted"> · note: {game.reviewNote}</span>}
            {' '}<a href="/admin">Back to queue</a>
          </span>
          <ReviewActions game={game} next="/admin" />
        </div>
      )
    }
    {
      desktopOnly ? (
        <section class="desktop-only panel" data-testid="desktop-only" role="note" aria-label={notice.heading}>
          <GameThumb game={game} class="desktop-only-art" eager previewToken={previewToken} />
          <div>
            <p class="eyebrow">{notice.heading}</p>
            <p class="desktop-only-title">{notice.title}</p>
            <p class="desktop-only-message">{notice.message}</p>
          </div>
        </section>
      ) : (
    <div class="stage-wrap">
      <div id="stage" class="stage" data-game-id={game.id} data-game-title={game.title} data-game-stage={game.stage} data-cdn={CDN_ORIGIN} data-cloud={user ? '1' : ''} data-preview={previewToken ?? ''}>
        <button class="launch" type="button" aria-label={`Play ${game.title}`}>
          <GameThumb game={game} class="preview-art" eager previewToken={previewToken} />
          <span class="preview-shade" aria-hidden="true"></span>
          <span class="preview-body">
            <span class="play-icon" aria-hidden="true">▶</span>
            <span class="preview-title">{game.title}</span>
            <span class="preview-meta">by @{game.creator} · {ratingLabel(game.avgRating, game.ratingCount)}</span>
            <span class="muted mono preview-size">{kb(game.sizeBytes)} · loads instantly</span>
          </span>
        </button>
      </div>
      <div class="toolbar spread">
        <div class="row">
          <span class:list={['badge', game.stage]}>{live ? 'Live' : awaitingReview ? 'Awaiting review' : game.stage === 'rejected' ? 'Rejected' : game.stage === 'pending' ? 'Pending' : 'Proving Grounds'}</span>
          <span id="best" class="mono muted"></span>
          <span class="mono muted small">{user ? '☁ cloud saves on' : <a href={`/login?next=/play/${game.slug}`}>log in for cloud saves</a>}</span>
        </div>
        <div class="row">
          <button class="btn ghost sm" type="button" id="restart">↻ Restart</button>
          <button class="btn ghost sm" type="button" id="fullscreen" aria-label="Fullscreen">⛶ Fullscreen</button>
          {remixable && <a class="btn ghost sm" href={`${CDN_ORIGIN}/g/${game.id}/index.html?source${ptQuery}`} target="_blank" rel="noopener">{'</>'} Source</a>}
          {remixable && live && <a class="btn sm" href={`/upload?fork=${game.slug}`}>⑂ Fork</a>}
          {isOwner && <a class="btn ghost sm" href="/me">Manage</a>}
        </div>
      </div>
    </div>
      )
    }

    <div class="info">
      <div class="main-col">
        <h1>{game.title}</h1>
        <p class="byline muted">
          by <a href={`/u/${game.creator}`}>@{game.creator}</a> · {ago(game.createdAt)} · {count(game.plays, "play")} · {game.license}
          {parent && <> · fork of {forkParentLinked(device, parent.inputSupport) ? <a href={`/play/${parent.slug}`}>{parent.title}</a> : parent.title}</>}
        </p>
        {game.tagline && <p class="tagline">{game.tagline}</p>}
        <div class="chips">{game.tags.map((t) => <a class="tag" href={`/games?tag=${t}`}>#{t}</a>)}</div>
        <div class="rate-box panel">
          <span class="eyebrow">Your rating</span>
          <Rate slug={game.slug} avg={game.avgRating} count={game.ratingCount} mine={mine} />
        </div>
        {game.description && <p class="description">{game.description}</p>}
        {
          forks.length > 0 && (
            <>
              <h3>Forks ({forks.length})</h3>
              <ul class="forks">{forks.map((f) => <li><a href={`/play/${f.slug}`}>{f.title}</a> <span class="muted">by @{f.creator}</span></li>)}</ul>
            </>
          )
        }
      </div>

      <aside class="panel health">
        <span class="eyebrow">{live ? 'Graduated' : `Graduation · ${passed}/${checks.length} checks`}</span>
        <h3>{live ? 'Game health' : 'Road out of the Proving Grounds'}</h3>
        <p class="muted small">
          {
            live
              ? `Graduated to the main arcade. Every check passed.`
              : `Measured automatically from real plays. Once every check passes after ${GRADUATION.minPlays}+ plays, the game is eligible — the Meshground team promotes it to the main arcade.`
          }
        </p>
        <ul>
          {
            checks.map((c) => (
              <li class:list={{ pass: c.pass }}>
                <span>{c.label}</span>
                <span class="mono">
                  {formatCheck(c.value, c.format)}
                  <span class="muted"> / {c.comparator === 'lte' ? '≤' : '≥'}{formatCheck(c.target, c.format)}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    {
      more.length > 0 && (
        <div class="section">
          <h2>More from @{game.creator}</h2>
          <div class="grid">{more.map((g) => <GameCard game={g} />)}</div>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .play { padding-top: 1.5rem; }
  .notice { margin-bottom: 1rem; border-color: #c4ff3d55; }
  .reviewer { border-color: #ffb34055; gap: 1rem; }
  .reviewer a { color: var(--accent); }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 78vh;
    width: 100%;
    background: #000;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    /* Keep the running game's layout and paint isolated from the rest of the page. */
    contain: layout paint;
  }
  .stage:fullscreen,
  .stage:-webkit-full-screen { border-radius: 0; max-height: none; border: 0; }
  .launch {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    background: radial-gradient(circle at center, #1a2408, #000 70%);
    border: 0;
    color: var(--text);
    font: 800 1.4rem var(--sans);
    cursor: pointer;
  }
  .launch { padding: 0; overflow: hidden; }
  .launch:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .launch :global(.preview-art) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .preview-shade { position: absolute; inset: 0; background: radial-gradient(circle at center, #0008, #000c 75%); }
  .preview-body { position: relative; display: grid; justify-items: center; gap: 0.5rem; padding: 1rem; text-align: center; }
  .preview-title { font: 800 clamp(1.2rem, 3.2vw, 2.2rem) / 1.1 var(--sans); text-shadow: 0 2px 12px #000; }
  .preview-meta { font-size: 0.95rem; font-weight: 600; color: #e6e9f2; text-shadow: 0 1px 8px #000; }
  .launch .mono { font-size: 0.8rem; font-weight: 400; }
  @media (max-width: 480px) {
    .play-icon { width: 64px; height: 64px; font-size: 1.5rem; }
    .preview-meta { font-size: 0.8rem; }
    .preview-size { display: none; }
  }
  .play-icon {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 2rem;
    padding-left: 6px;
    box-shadow: 0 0 60px #c4ff3d66;
    transition: transform 0.15s;
  }
  .launch:hover .play-icon { transform: scale(1.08); }
  .toolbar { padding: 0.75rem 0; }
  .info { display: grid; grid-template-columns: 1fr 360px; gap: 2rem; margin-top: 1rem; }
  .info h1 { font-size: 2.4rem; margin-bottom: 0.25rem; }
  .byline a { color: var(--text); }
  .tagline { font-size: 1.1rem; }
  .rate-box { margin: 1.25rem 0; }
  .description { white-space: pre-line; color: #c9cdd9; }
  .forks { padding-left: 1.2rem; }
  .health ul { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.5rem; }
  .health li { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; padding-left: 1.4rem; position: relative; }
  .health li::before { content: '○'; position: absolute; left: 0; color: var(--warn); }
  .health li.pass::before { content: '●'; color: var(--accent); }
  .small { font-size: 0.85rem; }
  .desktop-only {
    display: grid;
    grid-template-columns: minmax(180px, 320px) 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .desktop-only :global(.desktop-only-art) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; background: #000; }
  .desktop-only-title { margin: 0.35rem 0; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; }
  .desktop-only-message { margin: 0; font-size: 1.05rem; }
  @media (max-width: 900px) {
    .info, .desktop-only { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { mountPlayer, preloadSave, type PlayerHandle } from '../../client/player';
  import { attachStageFullscreen } from '../../client/stage-fullscreen';

  // Desktop-only visits render the notice instead of #stage, so this script no-ops there.
  const stage = document.getElementById('stage');
  if (stage) {
    const { gameId, gameTitle, gameStage, cdn, cloud, preview } = stage.dataset;
    const game = { id: gameId!, title: gameTitle!, stage: gameStage as 'proving' | 'live' };
    const best = document.getElementById('best')!;
    const showBest = (n: number) => (best.textContent = Number.isFinite(n) ? `Your best: ${n}` : '');
    showBest(Number(localStorage.getItem(`mg:best:${game.id}`) ?? NaN));

    // Warm the cloud save on hover/focus/touch (intent to play) so the click launches straight away.
    const warm = () => preloadSave(game.id, !!cloud);
    ['pointerenter', 'focusin', 'touchstart'].forEach((t) => stage.addEventListener(t, warm, { once: true, passive: true }));

    let player: PlayerHandle | null = null;
    const start = () => {
      player?.destroy();
      player = mountPlayer(stage, game, {
        cdnOrigin: cdn!,
        cloudSaves: !!cloud,
        previewToken: preview || null,
        onEvent: (type, data) => type === 'SCORE' && showBest(Number(data.best)),
      });
      player.frame.focus();
    };
    stage.querySelector('.launch')!.addEventListener('click', start);
    document.getElementById('restart')!.addEventListener('click', start);
    // Fullscreen is the same for every game: the shared stage, never a per-game hook.
    const fullscreenBtn = document.getElementById('fullscreen');
    if (fullscreenBtn instanceof HTMLButtonElement) {
      const fullscreen = attachStageFullscreen(stage, fullscreenBtn);
      fullscreenBtn.addEventListener('click', () => {
        if (!player) start();
        void fullscreen.toggle().then((mode) => {
          // CSS mode needs the toolbar focused so Escape reaches this document.
          // Leaving either mode returns focus here. Native enter keeps the game focused;
          // the × inside the stage is on screen for that mode.
          if (mode === 'native') player?.frame.focus();
          else fullscreenBtn.focus();
        });
      });
    }
  }
</script>
