---
import Layout from '../layouts/Layout.astro';
import GameThumb from '../components/GameThumb.astro';
import UploadSection from '../components/UploadSection.astro';
import McpSection from '../components/McpSection.astro';
import { getGame, listGames, ownerReviewMarks } from '../lib/server/games';
import { listApiTokens } from '../lib/server/api-tokens';
import { ownerPreviewToken } from '../lib/server/owner-preview';
import { readManualReview } from '../lib/server/manual-review';
import { count, stars, ago } from '../lib/format';

const { user, profile } = Astro.locals;
const NO_STORE = 'private, no-store';
Astro.response.headers.set('Cache-Control', NO_STORE);
if (!user || !profile) {
  // Astro.redirect returns a fresh Response, so the header must be set on it directly.
  const r = Astro.redirect('/login?next=/me');
  r.headers.set('Cache-Control', NO_STORE);
  return r;
}
const forkSlug = Astro.url.searchParams.get('fork');
const [games, manualReview, fork, tokens] = await Promise.all([
  listGames({ ownerId: user.id, sort: 'new', limit: 200, includeUnpublished: true }),
  readManualReview(),
  forkSlug ? getGame(forkSlug) : null,
  listApiTokens(user.id),
]);
const forkable = fork && fork.license !== 'All rights reserved' ? fork : null;
const marks = await ownerReviewMarks(games.map((g) => g.id));
const stageText = (stage: string, id: string) => {
  if (stage === 'pending' && marks.get(id)?.latestStatus === 'passed') return 'Awaiting review';
  if (stage === 'pending') return 'Validating…';
  if (stage === 'proving') return 'Proving Grounds';
  if (stage === 'live') return 'Live';
  return 'Rejected';
};
const plays = games.reduce((n, g) => n + g.plays, 0);
const deleted = Astro.url.searchParams.has('deleted');
---

<Layout title="Your dashboard">
  <section class="section wrap">
    <div class="spread">
      <div>
        <span class="eyebrow">Creator dashboard</span>
        <h1>@{profile.handle}</h1>
        <p class="muted mono">{user.email} · {count(games.length, "game")} · {count(plays, "play")}</p>
      </div>
      <div class="row">
        <a class="btn ghost" href={`/u/${profile.handle}`}>Public profile</a>
        <a class="btn ghost" href="#mcp">Connect your AI</a>
        <a class="btn" href="#upload">Upload a game</a>
      </div>
    </div>
    {deleted && <p class="panel notice">Game deleted.</p>}

    {
      games.length ? (
        <ul class="list">
          {games.map((g) => (
            <li class="panel item">
              <a href={g.stage === 'pending' || g.stage === 'rejected' ? `/submissions/${g.id}` : `/play/${g.slug}`} class="thumb"><GameThumb game={g} class="art" previewToken={ownerPreviewToken(g, user.id)} /></a>
              <div class="meta">
                <a href={g.stage === 'pending' || g.stage === 'rejected' ? `/submissions/${g.id}` : `/play/${g.slug}`}><h3>{g.title}</h3></a>
                <p class="muted mono">
                  <span class:list={['badge', g.stage]}>{stageText(g.stage, g.id)}</span>{' '}
                  {count(g.plays, "play")} · ★ {stars(g.avgRating)} ({g.ratingCount}) · uploaded {ago(g.createdAt)}
                </p>
                {g.stage === 'rejected' && g.reviewNote && <p class="review-note">{g.reviewNote}</p>}
                <a href={`/games/${g.slug}/assets`}>Assets</a>
              </div>
              <form method="post" action={`/api/games/${g.slug}/delete`} class="del" data-confirm={`Delete “${g.title}” permanently? Plays, ratings and player saves will be removed.`}>
                <button class="btn ghost sm" type="submit">Delete</button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <div class="panel empty">
          <p>You haven't uploaded anything yet.</p>
          <a class="btn" href="#upload">Ship your first game</a>
        </div>
      )
    }
  </section>

  <section class="section wrap">
    <UploadSection profile={profile} forkable={forkable} manualReview={manualReview}>
      <McpSection slot="mcp" tokens={tokens} revoked={Astro.url.searchParams.has('revoked')} />
    </UploadSection>
  </section>

  <section class="section wrap account">
    <span class="eyebrow">Account</span>
    <p class="muted mono">{user.email}</p>
    <form method="post" action="/api/auth/logout" class="logout"><button class="btn ghost sm" type="submit">Log out</button></form>
  </section>
</Layout>

<style>
  .list { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 0.75rem; }
  .item { display: grid; grid-template-columns: 120px 1fr auto; gap: 1rem; align-items: center; padding: 0.75rem; }
  .thumb { aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; display: block; }
  .thumb :global(.art) { width: 100%; height: 100%; object-fit: cover; }
  .meta h3 { margin: 0 0 0.3rem; }
  .meta a { text-decoration: none; }
  .meta p { margin: 0; font-size: 0.8rem; }
  .review-note { display: block; margin-top: 0.35rem; color: var(--bad); }
  .notice { margin-top: 1rem; border-color: #c4ff3d55; }
  .empty { text-align: center; padding: 3rem; margin-top: 2rem; }
  .account { border-top: 1px solid var(--line); }
  .account p { margin: 0 0 1rem; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm)) e.preventDefault();
    }),
  );
</script>
