---
// The upload form lives on the creator dashboard (/me#upload). This route stays as an alias so
// old links, docs, and `?fork=<slug>` keep working.
const fork = Astro.url.searchParams.get('fork');
const target = `/me${fork ? `?fork=${encodeURIComponent(fork)}` : ''}#upload`;
if (!Astro.locals.profile) return Astro.redirect(`/login?mode=signup&next=${encodeURIComponent(target)}`);
return Astro.redirect(target);
---
