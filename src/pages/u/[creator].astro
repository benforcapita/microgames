---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { listGames } from '../../lib/server/games';
import { compact, count } from '../../lib/format';

const creator = Astro.params.creator ?? '';
// PV-1: visitors see only listable games; the creator viewing their own profile also sees their proving games.
const { user, profile } = Astro.locals;
const own = !!user && !!profile && profile.handle.toLowerCase() === creator.toLowerCase();
const games = await listGames({ creator, sort: 'new', limit: 100, device: Astro.locals.device, ...(own ? { ownerId: user!.id, includeUnlisted: true } : {}) });
if (!games.length) return Astro.rewrite('/404');
const plays = games.reduce((n, g) => n + g.plays, 0);
const live = games.filter((g) => g.stage === 'live').length;
---

<Layout title={`@${creator}`}>
  <section class="section wrap">
    <span class="eyebrow">Creator</span>
    <h1>@{creator}</h1>
    <p class="muted mono">{count(games.length, "game")} · {live} graduated · {count(plays, "play")}</p>
    <div class="grid">{games.map((g) => <GameCard game={g} />)}</div>
  </section>
</Layout>
