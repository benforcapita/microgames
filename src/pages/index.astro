---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import GameThumb from '../components/GameThumb.astro';
import { listGames, platformStats } from '../lib/server/games';
import { compact } from '../lib/format';
import { getContent, getFeatured } from '../lib/server/content';

// PV-1: only listable games (isListable in game-rules.ts) appear here; proving games are share-by-link only.
const device = Astro.locals.device;
const [live, stats, copy, banner, featured] = await Promise.all([
  listGames({ stage: 'live', sort: 'top', limit: 8, device }),
  platformStats(device),
  getContent('home.hero'),
  getContent('home.banner'),
  getFeatured(8, device),
]);
// Featured games come from featured_games; without any, the hero falls back to the current ordering (top live game).
const hero = featured[0]?.game ?? live[0];
const heroLabel = featured[0]?.label || 'Featured';
const loggedIn = !!Astro.locals.user;
---

<Layout>
  {
    banner.text && (
      <aside class:list={['banner', 'wrap', `tone-${banner.tone}`]} role="note" aria-label="Announcement">
        {banner.image_url && <img src={banner.image_url} alt="" class="banner-img" loading="lazy" />}
        <p>{banner.text}</p>
        {banner.link_href && banner.link_label && <a class="btn sm" href={banner.link_href}>{banner.link_label}</a>}
      </aside>
    )
  }

  {
    featured.length > 0 && (
      <section class="section wrap games-top" aria-labelledby="featured-title">
        <div class="spread head">
          <h2 id="featured-title">Featured</h2>
        </div>
        <div class="grid">
          {featured.map((f) => (
            <div class="featured-item">
              {f.label && <span class="eyebrow">{f.label}</span>}
              <GameCard game={f.game} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section wrap games-top">
    <div class="spread head">
      <h2>Top games</h2>
      <a href="/games" class="muted">All games →</a>
    </div>
    {live.length ? <div class="grid">{live.map((g) => <GameCard game={g} />)}</div> : <p class="muted">No graduated games yet.</p>}
  </section>

  <section class="hero wrap">
    <div class="copy">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title_before}<span class="accent">{copy.title_accent}</span>{copy.title_after}</h1>
      <p class="lede muted">{copy.lede}</p>
      <div class="row">
        <a class="btn" href="/games">Start playing</a>
        <a class="btn ghost" href="/upload">Upload your game →</a>
      </div>
      <dl class="stats mono">
        <div><dt>games</dt><dd>{compact(stats.games)}</dd></div>
        <div><dt>plays</dt><dd>{compact(stats.plays)}</dd></div>
        <div><dt>creators</dt><dd>{compact(stats.creators)}</dd></div>
      </dl>
    </div>
    {
      hero && (
        <a class="feature" href={`/play/${hero.slug}`}>
          <GameThumb game={hero} class="feature-art" />
          <div class="feature-cap">
            <span class="badge live">{heroLabel}</span>
            <h2>{hero.title}</h2>
            <p class="muted">{hero.tagline}</p>
            <span class="btn sm">▶ Play now</span>
          </div>
        </a>
      )
    }
  </section>

  {
    !loggedIn && (
      <section class="section wrap" id="signup" aria-labelledby="signup-title">
        <div class="signup panel">
          <div>
            <span class="eyebrow">Free account</span>
            <h2 id="signup-title">Sign up free to keep playing.</h2>
            <p class="muted">Your first game is on us. A free account takes seconds and unlocks the rest of the grounds.</p>
            <div class="row">
              <a class="btn" href="/login?mode=signup">Sign up free</a>
              <a class="btn ghost" href="/login">I have an account</a>
            </div>
          </div>
          <ul class="perks">
            <li><b>Unlimited play</b><span class="muted">Every live and Proving Grounds game, as often as you like.</span></li>
            <li><b>Ratings</b><span class="muted">Your stars help decide which games reach the main arcade.</span></li>
            <li><b>Cloud saves</b><span class="muted">Progress follows you across devices.</span></li>
            <li><b>Uploading</b><span class="muted">Ship your own single-file game.</span></li>
          </ul>
        </div>
      </section>
    )
  }

</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: 4rem 2rem;
  }
  /* Games lead the page; the first grid sits right under the header, the hero follows. */
  .games-top { padding-block: 2rem 0.5rem; }
  .games-top + .hero { padding-block: 3rem 2rem; }
  .lede { font-size: 1.12rem; max-width: 36rem; }
  .stats { display: flex; gap: 2.5rem; margin: 2.5rem 0 0; }
  .stats dt { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .stats dd { margin: 0; font-size: 1.8rem; font-weight: 700; }
  .feature {
    position: relative;
    display: block;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    text-decoration: none;
    box-shadow: 0 40px 120px -40px #c4ff3d44;
    transform: perspective(1200px) rotateY(-6deg);
    transition: transform 0.3s;
  }
  .feature:hover { transform: perspective(1200px) rotateY(0); }
  .feature :global(.feature-art) { width: 100%; height: 100%; object-fit: cover; }
  .feature-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem;
    background: linear-gradient(transparent, #000d 40%);
  }
  .feature-cap h2 { margin: 0.6rem 0 0.25rem; font-size: 2rem; }
  .head { margin-bottom: 1.25rem; }
  .banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #ffffff08;
  }
  .banner p { margin: 0; flex: 1; }
  .banner-img { width: 48px; height: 48px; object-fit: cover; border-radius: 10px; }
  .tone-promo { border-color: #c4ff3d66; background: #c4ff3d12; }
  .tone-warning { border-color: #ffb43d88; background: #ffb43d14; }
  .featured-item { display: grid; gap: 0.4rem; }
  .head h2 { margin: 0; }
  .head a { text-decoration: none; }
  .signup { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; padding: 2.5rem; border-color: #c4ff3d55; }
  .signup h2 { margin: 0.4rem 0 0.6rem; }
  .perks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .perks li { display: grid; gap: 0.25rem; align-content: start; }
  @media (max-width: 860px) {
    .perks { grid-template-columns: 1fr; }
    .hero, .signup { grid-template-columns: 1fr; }
    .feature { transform: none; }
  }
</style>
