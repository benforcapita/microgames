---
import type { Game } from '../lib/server/games';
import { CDN_ORIGIN } from '../lib/server/config';
import MeshArt from './MeshArt.astro';

interface Props {
  game: Pick<Game, 'id' | 'thumb' | 'hue'>;
  class?: string;
  eager?: boolean;
  previewToken?: string | null;
}
const { game, class: className, eager = false, previewToken } = Astro.props;
---

{
  game.thumb ? (
    <img
      class={className}
      src={`${CDN_ORIGIN}/g/${game.id}/${game.thumb}${previewToken ? `?pt=${encodeURIComponent(previewToken)}` : ''}`}
      alt=""
      aria-hidden="true"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  ) : (
    <MeshArt class={className} seed={game.id} hue={game.hue} />
  )
}
