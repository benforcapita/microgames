---
interface Props {
  slug: string;
  avg: number | null;
  count: number;
  mine: number | null;
}
const { slug, avg, count, mine } = Astro.props;
const loggedIn = !!Astro.locals.user;
---

<div class="rate" data-rate={slug} data-mine={mine ?? ''}>
  {!loggedIn && <a class="login" href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`}>Log in to rate</a>}
  <div class="stars" role="radiogroup" aria-label="Rate this game" hidden={!loggedIn}>
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button type="button" role="radio" data-stars={n} aria-checked={mine === n ? 'true' : 'false'} aria-label={`${n} star${n > 1 ? 's' : ''}`} class:list={{ on: (mine ?? 0) >= n }}>
          ★
        </button>
      ))
    }
  </div>
  <button type="button" class="clear" data-clear hidden={!loggedIn || mine === null} aria-label="Clear my rating">Clear</button>
  <span class="summary mono muted" aria-live="polite">{avg === null ? 'No ratings yet' : `${avg.toFixed(1)} · ${count} votes`}</span>
</div>

<style>
  .rate { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .stars { display: flex; }
  button {
    background: none;
    border: 0;
    font-size: 1.5rem;
    line-height: 1;
    padding: 0 0.1rem;
    color: #3a3f52;
    cursor: pointer;
    transition: color 0.1s, transform 0.1s;
  }
  button.on { color: var(--accent); }
  .stars:hover button { color: var(--accent); }
  .stars button:hover ~ button { color: #3a3f52; }
  button:hover { transform: scale(1.15); }
  .summary { font-size: 0.8rem; }
  button.clear { font: 600 0.78rem var(--mono); color: var(--muted); padding: 0.2rem 0.5rem; border: 1px solid var(--line); border-radius: 999px; }
  button.clear:hover { color: var(--text); transform: none; }
  .login { color: var(--accent); font-size: 0.9rem; font-weight: 600; }
</style>

<script>
  const summary = (d: { avgRating: number | null; ratingCount: number }, note: string) =>
    `${d.avgRating === null ? 'No ratings yet' : `${d.avgRating.toFixed(1)} · ${d.ratingCount} votes`} · ${note}`;
  // Stars only change after the server saved (or cleared) the rating.
  const paint = (root: HTMLElement, stars: number) => {
    root.querySelectorAll<HTMLButtonElement>('button[data-stars]').forEach((b) => {
      const n = Number(b.dataset.stars);
      b.classList.toggle('on', n <= stars);
      b.setAttribute('aria-checked', String(n === stars));
    });
    root.dataset.mine = stars ? String(stars) : '';
    root.querySelector<HTMLButtonElement>('[data-clear]')!.hidden = !stars;
  };
  const errorText = async (res: Response) =>
    res.status === 403
      ? "You can't rate your own game."
      : res.status === 429
        ? 'Too many ratings, try again later.'
        : (await res.text()) || 'Could not save your rating.';

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>('[data-rate] button[data-stars]');
    const clear = target.closest<HTMLButtonElement>('[data-rate] button[data-clear]');
    if (!btn && !clear) return;
    const root = (btn ?? clear)!.closest<HTMLElement>('[data-rate]')!;
    const out = root.querySelector('.summary');
    const url = `/api/games/${root.dataset.rate}/rate`;
    const res = clear
      ? await fetch(url, { method: 'DELETE' })
      : await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ stars: Number(btn!.dataset.stars) }) });
    if (!res.ok) {
      if (out) out.textContent = await errorText(res);
      return;
    }
    const data = (await res.json()) as { avgRating: number | null; ratingCount: number; stars: number | null };
    paint(root, data.stars ?? 0);
    if (out) out.textContent = summary(data, clear ? 'rating cleared' : 'thanks!');
  });
</script>
