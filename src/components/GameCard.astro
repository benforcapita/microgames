---
import type { Game } from '../lib/server/games';
import { compact, count, stars } from '../lib/format';
import GameThumb from './GameThumb.astro';

interface Props {
  game: Game;
}
const { game } = Astro.props;
const filled = game.avgRating === null ? 0 : Math.round(game.avgRating);
const ratingLabel = game.avgRating === null ? 'No ratings yet' : `Rated ${stars(game.avgRating)} out of 5 from ${game.ratingCount} vote${game.ratingCount === 1 ? '' : 's'}`;
---

<a class="card" href={`/play/${game.slug}`}>
  <div class="thumb">
    <GameThumb game={game} class="art" />
    {game.stage === 'proving' && <span class="badge proving">Proving Grounds</span>}
  </div>
  <div class="body">
    <h3>{game.title}</h3>
    <p class="muted tagline">{game.tagline || 'An instant 3D web game.'}</p>
    <div class="meta mono">
      <span>@{game.creator}</span>
      <span>{count(game.plays, "play")}</span>
      <span class="rating" role="img" aria-label={ratingLabel} title={ratingLabel}>
        <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <i class:list={{ on: n <= filled }}>★</i>)}</span>
        {game.avgRating === null ? 'new' : `${stars(game.avgRating)} (${compact(game.ratingCount)})`}
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.15s, border-color 0.15s;
  }
  .card:hover { transform: translateY(-3px); border-color: #c4ff3d66; }
  .thumb { position: relative; aspect-ratio: 16 / 10; background: #000; }
  .thumb :global(.art) { width: 100%; height: 100%; object-fit: cover; }
  .thumb .badge { position: absolute; top: 0.6rem; left: 0.6rem; }
  .body { padding: 0.9rem 1rem 1rem; display: grid; gap: 0.35rem; }
  h3 { margin: 0; }
  .tagline { margin: 0; font-size: 0.88rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { display: flex; gap: 0.8rem; color: var(--muted); font-size: 0.75rem; flex-wrap: wrap; }
  .rating { display: inline-flex; align-items: center; gap: 0.35rem; }
  .stars i { font-style: normal; color: #3a3f52; }
  .stars i.on { color: var(--accent); }
</style>
