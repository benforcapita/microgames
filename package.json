{
  "name": "meshground",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev",
    "cdn": "node scripts/game-cdn.mjs",
    "build": "astro build",
    "start": "node scripts/dev.mjs start",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "node scripts/seed.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs --test \"src/**/*.test.ts\" \"mcp/**/*.test.ts\" \"cdn/**/*.test.ts\" \"scripts/**/*.test.ts\" && node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs --test --test-concurrency=1 \"supabase/**/*.test.ts\"",
    "test:mutation": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ci/mutation-diff.ts",
    "db:start": "npx -y supabase@2.120.0 start -x vector,logflare,edge-runtime,imgproxy,realtime",
    "db:stop": "npx -y supabase@2.120.0 stop",
    "check": "astro check",
    "check:pg-net": "node scripts/check-pg-net.mjs",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "thumbs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/capture-thumbs.mjs",
    "backfill:input": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs scripts/backfill-input-support.mjs",
    "backfill:categorization": "node scripts/backfill-categorization.mjs",
    "launch:video": "node launch/render.mjs",
    "check:copy": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-site-copy.mjs",
    "maintenance": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs scripts/asset-maintenance.mjs",
    "copy:site-content": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/list-site-content-money.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/vercel": "11.0.14",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "acorn": "^8.19.0",
    "astro": "7.3.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "24.19.1",
    "sharp": "^0.35.5",
    "typescript": "6.0.3"
  }
}
