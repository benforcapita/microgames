{
  "name": "meshgrounds",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev",
    "cdn": "node scripts/game-cdn.mjs",
    "build": "astro build",
    "start": "node scripts/dev.mjs start",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "node scripts/seed.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-ts.mjs --test \"**/*.test.ts\"",
    "db:start": "npx -y supabase@2.120.0 start -x vector,logflare,edge-runtime,imgproxy,realtime",
    "db:stop": "npx -y supabase@2.120.0 stop",
    "check": "astro check",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/vercel": "11.0.14",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "acorn": "^8.19.0",
    "astro": "7.3.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
