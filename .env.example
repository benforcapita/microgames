# --- Supabase (required) ---
# Dashboard → Project Settings → API Keys / Data API. Legacy anon / service_role keys also work.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Dashboard → Connect → Transaction pooler (port 6543) or direct connection string.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# For the local stack (`npx supabase start`) use:
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# and the Publishable / Secret keys printed by `npx supabase status`.

# --- Portal ---
# Optional public portal URL. Auth emails do not use this. sign-up and magic-link
# redirects are built from the request origin and checked against an allowlist
# (see src/lib/server/email-redirect.ts). Supabase Auth must allow
# https://www.meshground.app/** and https://meshground.app/** or it falls back to the project Site URL.
SITE_URL=http://localhost:4321
# Origins allowed to embed game frames (game CDN frame-ancestors)
MG_WEB_ORIGINS=http://localhost:* http://127.0.0.1:*
# Separate, cookieless origin that serves game bundles
MG_CDN_ORIGIN=http://localhost:4322
MG_CDN_PORT=4322
# Shared by the portal and the game CDN: signs 10-minute owner preview tokens for pending/rejected games.
# Generate with `openssl rand -base64 32`. Unset = pending/rejected bundles are never served.
CDN_PREVIEW_SECRET=
# HMAC key for the daily-rotating IP hash used by session admission.
# Raw IPs are never stored and are never session-admission limiter keys — only the
# hash is. (The in-memory limiter in /api/events still keys on the raw IP.)
# Required, minimum 32 characters — admission fails closed without it.
# Generate with `openssl rand -base64 32`.
# MG_IP_HASH_SECRET=
# Plays required before a game can graduate out of the Proving Grounds
MG_MIN_PLAYS=100
# Manual review lives only in private.settings, key mg_manual_review, seeded '1'.
# The portal and validate-game read it and never write it. To turn it off, in the
# Supabase SQL editor (schema private, table settings):
#   update private.settings set value = '0' where key = 'mg_manual_review';
# '0' auto-publishes a pass to proving. Anything else, including a missing row, stays on.
# Optional: Google AdSense H5 Games client id (ca-pub-...). Without it a mock ad overlay is used.
PUBLIC_ADSENSE_CLIENT=
