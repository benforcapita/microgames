# Public origin of the main portal (used by the game CDN for frame-ancestors)
MG_WEB_ORIGINS=http://localhost:4321 http://127.0.0.1:4321
# Separate, cookieless origin that serves uploaded game bundles
MG_CDN_ORIGIN=http://localhost:4322
MG_CDN_PORT=4322
# Where the SQLite DB and uploaded bundles live
MG_DATA_DIR=data
# Plays required before a game can graduate out of the Proving Grounds
MG_MIN_PLAYS=100
# Optional: Google AdSense H5 Games client id (ca-pub-...). Without it a mock ad overlay is used.
PUBLIC_ADSENSE_CLIENT=
