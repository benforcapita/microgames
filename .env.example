# --- Supabase (required) ---
# Dashboard → Project Settings → API Keys / Data API. Legacy anon / service_role keys also work.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Dashboard → Connect → Transaction pooler (port 6543) or direct connection string.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# For the local stack (`npx supabase start`) use:
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# and the Publishable / Secret keys printed by `npx supabase status`.

# --- Portal ---
# Public URL of the portal, used for auth email redirects (defaults to the request origin)
SITE_URL=http://localhost:4321
# Origins allowed to embed game frames (game CDN frame-ancestors)
MG_WEB_ORIGINS=http://localhost:* http://127.0.0.1:*
# Separate, cookieless origin that serves game bundles
MG_CDN_ORIGIN=http://localhost:4322
MG_CDN_PORT=4322
# Plays required before a game can graduate out of the Proving Grounds
MG_MIN_PLAYS=100
# Optional: Google AdSense H5 Games client id (ca-pub-...). Without it a mock ad overlay is used.
PUBLIC_ADSENSE_CLIENT=
